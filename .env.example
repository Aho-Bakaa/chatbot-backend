# Groq API key (required for /chat and /extract_and_questions)
GROQ_API_KEY=

# LLM model on Groq (OpenAI-compatible)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_TOKENS=1000

# Rate limit: sliding window, requests per minute, applied globally per process
RATE_LIMIT_PER_MINUTE=15

# Debug mode: when true, CORS origins fall back to ["*"] (demo convenience)
DEBUG=true

# Comma-separated list of allowed CORS origins used when DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Retrieval (RAG) layer
RETRIEVAL_ENABLED=true
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.25

# Embedding model (sentence-transformers; downloaded on first run)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Persisted vector store directory
CHROMA_DIR=chroma_db

# Load-testing helper: when true, /chat skips the real LLM call and returns
# a deterministic response after rate-limit + retrieval + logging. Used by
# benchmarks/run_benchmarks.py to isolate app-layer latency from LLM latency.
BENCHMARK_BYPASS_LLM=false

# Log file (stdout is always used; file optional)
LOG_FILE=
